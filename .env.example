# Copy to .env (git-ignored) and fill in. Never commit the real file.

# --- Infoblox (WAPI) ---
INFOBLOX_HOST=infoblox.example.com
INFOBLOX_USER=svc-ocp-dns
INFOBLOX_PASSWORD=changeme
INFOBLOX_WAPI_VERSION=v2.12
INFOBLOX_VERIFY_SSL=false          # true, false, or path to a CA bundle

# --- HashiCorp Vault (BMC/Redfish credentials live here) ---
VAULT_ADDR=https://vault.example.com:8200
# Use EITHER a token ...
VAULT_TOKEN=
# ... OR AppRole
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_NAMESPACE=                   # Vault Enterprise only, else leave empty
VAULT_VERIFY_SSL=true              # true, false, or path to a CA bundle

# --- Redfish ---
REDFISH_VERIFY_SSL=false           # BMCs usually have self-signed certs

# --- Local inputs ---
PULL_SECRET_FILE=./pull-secret.json
SSH_PUBKEY_FILE=                   # empty = generate work/<cluster>/id_ed25519
